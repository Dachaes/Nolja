{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --config .prettierrc.json --write \"src/**/*.{ts,tsx,scss}\" \"tests/**/*.{ts,mjs}\" \"*.{ts,js,json,html}\" \"../backend/src/**/*.java\"",
    "format:check": "prettier --config .prettierrc.json --check \"src/**/*.{ts,tsx,scss}\" \"tests/**/*.{ts,mjs}\" \"*.{ts,js,json,html}\" \"../backend/src/**/*.java\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.8.3",
    "prettier-plugin-java": "^2.11.0",
    "sass": "^1.108.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
}
