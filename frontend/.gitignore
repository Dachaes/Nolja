# npm으로 다시 설치할 수 있는 의존성과 Vite 빌드 결과입니다.
/node_modules/
/dist/
/dist-ssr/

# Vite, TypeScript, ESLint가 생성하는 캐시입니다.
/.vite/
/.vite-temp/
*.tsbuildinfo
.eslintcache

# 테스트가 생성하는 보고서, 스크린샷, 실행 추적, 인증 상태입니다.
/coverage/
/.nyc_output/
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
/playwright/.auth/
/.auth/
/storage-state*.json

# 실행 로그는 개발 환경마다 달라 저장소에서 제외합니다.
/logs/
*.log
*.log.*
npm-debug.log*

# 환경별 값은 제외하되 비밀값 없는 설정 예제는 공유합니다.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template

# package.json과 package-lock.json, src/, public/은 Git에 포함합니다.
